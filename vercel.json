{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/games/turtle-rider", "destination": "/games/turtle-rider/", "permanent": false },
    { "source": "/games/cattetris", "destination": "/games/cattetris/", "permanent": false },
    { "source": "/games/philosophy", "destination": "/games/philosophy/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/games/turtle-rider/(.*)", "destination": "https://khk9562.github.io/turtle-rider/$1" },
